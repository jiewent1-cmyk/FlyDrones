# FHB v1 delta on top of course_base.parm -- SITL variant (TechRoute v2.2 §5.3)
# Values checked against Copter-4.7.0 source on 2026-10-01. Real-FC differences noted per line.
# --- optical flow + rangefinder (Matek 3901-L0X on UART4, MSP) ---
FLOW_TYPE        10
# real FC: FLOW_TYPE 7 (MSP)
RNGFND1_TYPE     100
# real FC: RNGFND1_TYPE 32 (MSP), SERIAL4_PROTOCOL 32, SERIAL4_BAUD 115
RNGFND1_ORIENT   25
RNGFND1_MAX      1.2
RNGFND1_MIN      0.03
RNGFND1_GNDCLR   0.03
EK3_SRC1_POSXY   0
EK3_SRC1_VELXY   5
# S7c (8 SITL runs, 2026-10-01): baro primary + RNG_USE_HGT 70 latched a 0.3-0.45 m height bias after crossing 0.84 m;
# rangefinder primary kept |err| <= 0.10 m because the 1.0 m soft ceiling keeps it inside the 1.2 m range
EK3_SRC1_POSZ    2
EK3_RNG_USE_HGT  -1
EK3_SRC1_VELZ    0
EK3_SRC1_YAW     1
GPS1_TYPE        0
# bit3 GPS lock + bit12 GPS configuration
ARMING_SKIPCHK   4104
# --- cage envelope (bounded by 1.2 m rangefinder) ---
RTL_ALT_M        0.8
LOIT_SPEED_MS    1.0
WP_SPD           0.5
PILOT_SPD_UP     0.5
FENCE_ENABLE     1
# circle fence (bit 2) blocks arming without GPS: "Fence requires position" (SITL S7, 2026-10-01) -> altitude only
FENCE_TYPE       1
FENCE_ALT_MAX    1.3
# course FENCE_MARGIN=2 makes fence avoidance (AVOID_ENABLE bit0) cap climb at 1.3-2 = -0.7 m: vehicle cannot take off.
# 0.3 -> soft ceiling 1.0 m (avoidance, all position-controlled modes) + hard breach 1.3 m -> FENCE_ACTION
FENCE_MARGIN     0.3
FENCE_ACTION     2
GUID_TIMEOUT     1
BATT_CAPACITY    2200
BATT_FS_LOW_ACT  1
# --- Orange Pi (SERIAL2 -> MAV2) streams, F1 belt-and-braces ---
MAV2_POSITION    20
MAV2_EXTRA1      20
MAV2_EXT_STAT    2
# --- SITL-only sensor models (3901-L0X priors) ---
SIM_GPS1_ENABLE  0
SIM_FLOW_ENABLE  1
# real MSP output rate unknown -- HIGH sensitivity: 20 Hz -> loiter xy std 0.7-1.4 m, 50 Hz -> 0.1-0.2 m
SIM_FLOW_RATE    20
SIM_FLOW_DELAY   10
SIM_FLOW_RND     0.05
SIM_SONAR_RND    0.03
