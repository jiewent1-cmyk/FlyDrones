# MTF-01 光流+测距 定位参数建议（2026-11-19，ArduCopter 4.7.0 SITL 结果 + 源码核对）
# 只写真机参数名（不含 SIM_* / FLOW_TYPE / RNGFND1_TYPE 等仿真专用项）。
# 格式：<参数> <建议值>   # 现值 -> 建议值；依据（运行名）；影响
# 依据中的运行名见 runs/<tag>/，汇总见 report.md / results.csv。
# 标 [未仿真] 的是按源码或安装几何推算，SITL 没有验证。
#
# --- 高度源 ---
EK3_SRC1_POSZ 2            # 现值 2 -> 2（不变）。测距直接做高度源。上一轮 q2_RNG：任务高度 RMS 0.011 m、
                           # EKF 高度误差 0.014 m；本轮 mis_clean 任务高度 RMS 0.022 m、EKF 高度误差 0.030 m
EK3_RNG_M_NSE 0.1          # 现值 0.5（默认）-> 0.1。**本轮收益最大的一项**。
                           # 依据 fu3/fu5 vs fu3p/fu5p（测距读数上跳 1.5 m 持续 3 s / 5 s）：
                           # EKF 高度误差 RMS 从 0.357 / 0.494 m 降到 0.024 / 0.026 m（改善 15-20 倍，
                           # 远大于重复间离散度 0.003 m）。MTF-01 标称精度 2%（2 m 处 0.04 m），0.1 m 是合理噪声。
                           # 代价：EKF 更相信测距，测距错的时候反应更快（见 EK3_RNG_I_GATE）
EK3_RNG_I_GATE 200         # 现值 500（默认）-> 200。与 EK3_RNG_M_NSE 0.1 配套：门限 = 5σ × 0.1 m = 0.5 m，
                           # 1.5 m 的跳变直接被拒。依据同 fu3p/fu5p（与上一条同一组运行，不能单独归因）
EK3_HGT_I_GATE 200         # 现值 500（默认）-> 200。源码说明：EK3_GLITCH_RAD=0 时高度新息被截断而不是拒绝，
                           # 官方建议 EK3_HGT_I_GATE 不超过 300 以限制高度传感器瞬态误差的影响。
                           # 依据 fu3p/fu5p（prot 组同时含此项）
EK3_SRC2_POSZ 1            # 现值 1 -> 1（不变）。**注意：这不是气压备用**。EKF3 里 SRC1/SRC2/SRC3 分别是
                           # IMU0/IMU1/IMU2 三个实例各自的高度源配置（AP_NavEKF_Source.h），不是主/备。
                           # 真正的自动回退：测距数据 500 ms 没更新 -> 切气压（AP_NavEKF3_PosVelFusion.cpp:1275）
EK3_SRC1_POSXY 0           # 现值 0 -> 0（不变）。光流只做速度源，不做位置源
EK3_RNG_USE_HGT -1         # 现值 -1 -> -1（不变）。测距已经是主高度源，不需要再用"气压+测距切换"那套
#
# --- 光流 EKF ---
EK3_FLOW_M_NSE 0.25        # 现值 0.25 -> 0.25（不变）。**不改**。
                           # 扫描 hn_base/hn_m01/hn_m05/hn_m10（光流噪声 0.2 rad/s 下 M_NSE 0.1/0.25/0.5/1.0）：
                           # 单跑看 0.1 最好（终点漂移 0.107 vs 0.434），但 A/B 复测（ab_base vs ab_recA，各 3 次，
                           # 终点漂移中位 0.396 vs 0.442）没有复现，差异小于重复离散度，所以不改。
                           # 真机光流噪声要自己从 dataflash 的 OF 量测出来再定
EK3_FLOW_I_GATE 300        # 现值 300 -> 300（不变），未跑扫描
EK3_FLOW_DELAY 10          # 现值 10 -> 10（不变）。上一轮 SITL 分辨不出 50/100 ms 延迟的差别；
                           # 真机用日志 OF.flowX 与 IMU 角速率互相关测实际延迟再定
EK3_FLOW_MAX 2.5           # 现值 2.5 -> 2.5（不变），未跑扫描
EK3_TERR_GRAD 0.1          # 现值 0.1（默认）-> 0.1（不变），未跑扫描
#
# --- 传感器安装位置（**必须现场量，SITL 证据不足**）---
RNGFND1_POS_Z -0.05        # 现值 0 -> -0.05（假设 MTF-01 在 FC 下方 5 cm，**必须按实际安装改**）。
                           # 源码：EKF 用 rng += posOffsetEarth.z / cos(tilt) 把读数换算到 IMU 位置
                           # （AP_NavEKF3_PosVelFusion.cpp:1199）。不设的后果：高度有固定偏置，
                           # 而光流速度 = 角速度 × 高度，所以偏置直接按比例缩放速度估计。
                           # SITL 证据：ofs_base / ofs_raw / ofs_fixed 各 1 次，EKF-真值位置差 0.235 / 0.726 / 0.754，
                           # 未能分出差异（单次运行，离散度大）-> 标 [未仿真，需实测]
RNGFND1_GNDCLR 0.03        # 现值 0.03 -> 落地实测读数再改 [未仿真]
RNGFND1_MAX 8              # 现值 8 -> 8（不变）。**不需要调小**：fo3/fo5（读数 12 m）里驱动层就判了超量程，
                           # EKF 根本不收，真值高度偏离 ≤ 0.016 m，然后 EKF variance 保护降落。
                           # 调到 4 会有副作用：4 m 以上飞机会失去测距高度源、落回气压
RNGFND1_MIN 0.01           # 现值 0.01 -> 0.01（不变）
#
# --- 围栏 ---
FENCE_ALT_MAX 3.0          # 现值 2.5 -> 3.0。依据：苛刻场景里真值高度冲到 2.60-2.94 m，
                           # 2.5 + 余量 0.3 被触发，任务在第 2 圈被"Max Alt fence breached"打断
                           # （mis_base 落点 1.378 m，mis_recA 1.804 m，任务高度 RMS 0.41-0.50 m）。
                           # 前提：风引起的绝对高度漂移还没解决（见 report.md 结论 3），
                           # 若高度误差修好了就保持 2.5；6 m 网笼内 3.0 m 仍有余量
FENCE_MARGIN 0.3           # 现值 0.3 -> 0.3（不变，沿用上一轮）
FENCE_RADIUS 4             # 现值 3 -> 4（沿用上一轮：2 m 正方形对角点离起点 2.83 m，余量太小）
#
# --- 不动的（有意保持现值，说明理由）---
EK3_ACC_P_NSE 0.35         # 不改，未跑扫描
EK3_GYRO_P_NSE 0.03        # 不改，未跑扫描
EK3_ALT_M_NSE 2.0          # 不改，未跑扫描；气压只做测距丢失时的回退
EK3_HGT_DELAY 60           # 不改，未跑扫描
#
# --- 与本文件无关但必须一起改的（硬件侧，上一轮结论）---
# SERIAL4_PROTOCOL 1 / FLOW_TYPE 5 / RNGFND1_TYPE 10 / FLOW_ORIENT_YAW 0 / FLOW_FXSCALER 0 / FLOW_FYSCALER 0
# FLOW_POS_X / FLOW_POS_Y / FLOW_POS_Z  # 填 MTF-01 相对 IMU 的真实偏移（fpos_raw 单次运行：
#                                      # 偏前 5 cm 而飞控不知道时 EKF-真值位置差 1.565 m，最大 2.07 m）
# VISO_TYPE 1  # 保持发视觉消息，否则解锁检查报 "VisOdom: not healthy"（本轮首次起飞失败的原因）
